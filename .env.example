# Use only this key for local development work. Keep DATABASE_URL_PROD out of
# this file unless a separately approved production release requires it.
DATABASE_URL_DEV=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
VALIDATOR_DATABASE_ENVIRONMENT=development

# This remains a tracked, non-secret default. An absolute path may be used locally.
VALIDATOR_RULESET=config/rules/v1.toml
